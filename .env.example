# API/local development settings. Copy to the workspace root as .env.
# Keep .env private; never commit API tokens or production secrets.

NODE_ENV=development
SERVER_PORT=4000
SERVER_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Required at runtime. Use Supabase's transaction pooler URL for DATABASE_URL
# and its direct/session connection URL for DIRECT_URL migrations.
DATABASE_URL=
DIRECT_URL=

# Optional locally. Set strong, unique values before deploying.
# JWT_SECRET=
# JWT_REFRESH_SECRET=
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# Only required when intentionally running the admin seed.
# SEED_ADMIN_NAME=Admin
# SEED_ADMIN_PHONE=
# SEED_ADMIN_PASSWORD=

# Supabase Storage. Keep the service-role key server-side only.
STORAGE_TYPE=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=entron-public
SUPABASE_PRIVATE_BUCKET=entron-private

# NextSMS API v2. Intentionally blank until credentials are provided.
NEXTSMS_API_TOKEN=
# NEXTSMS_SENDER_ID=
# Comma-separated approved sender IDs exposed in the Entron SMS composer.
NEXTSMS_SENDER_IDS=

# WhatsApp requires an active NextSMS account and an approved template.
NEXTSMS_WHATSAPP_ACCOUNT=
NEXTSMS_WHATSAPP_TEMPLATE=
# Set true only if the approved template actually includes an image header.
NEXTSMS_WHATSAPP_HEADER_IMAGE=true
# Must match a placeholder in the approved template, without braces.
NEXTSMS_WHATSAPP_MESSAGE_PARAMETER=var1
NEXTSMS_WHATSAPP_ACCOUNTS=Entron cards
NEXTSMS_WHATSAPP_TEMPLATES=wedding_invitation,weddinginvitation
# Must match a placeholder in the approved template, without braces.
NEXTSMS_WHATSAPP_MESSAGE_PARAMETER=message

# Provider callback/webhook verification. Configure exact secret values on the provider dashboard.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
MPESA_CALLBACK_SECRET=
AIRTEL_CALLBACK_SECRET=
