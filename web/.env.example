# Local web development. The API is proxied through BACKEND_URL in next.config.ts.
BACKEND_URL=http://localhost:4000

# Public Supabase key is used only for signed Storage uploads.
# Never put SUPABASE_SERVICE_ROLE_KEY in the web environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
